rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function roster(code) {
      return get(/databases/$(database)/documents/durus_roster/$(code)).data;
    }
    function live(lesson) {
      return get(/databases/$(database)/documents/durus_live/$(lesson)).data;
    }

    // نتائج الطلاب
    match /durus_results/{id} {
      // المعلم يقرأ الجميع؛ والطالب يقرأ وثيقته برمزه فقط (لا يستطيع سرد الوثائق)
      allow get: if request.auth != null || ('code' in resource.data);
      allow list, delete: if request.auth != null;
      allow create, update: if
        request.resource.data.keys().hasOnly(['lesson','sid','name','cls','code','pre','post','scores','objectives','healed','nafes','nafesClass','nafesHome','survey','seen','updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.cls is string && request.resource.data.cls.size() <= 20
        && request.resource.data.lesson is string && request.resource.data.sid is string
        && id == request.resource.data.lesson + '__' + request.resource.data.sid
        // من دخل برمز: يجب أن يكون في الكشف وبالاسم والفصل نفسيهما
        && (!('code' in request.resource.data) || (
              request.resource.data.sid == 'r' + request.resource.data.code
              && exists(/databases/$(database)/documents/durus_roster/$(request.resource.data.code))
              && roster(request.resource.data.code).name == request.resource.data.name
              && roster(request.resource.data.code).cls == request.resource.data.cls))
        // محاولة الحصة: لا تُغيَّر بعد تسجيلها، ولا تُسجَّل إلا أثناء جلسة فصل الطالب
        && (!('nafesClass' in request.resource.data)
            || (resource != null && ('nafesClass' in resource.data) && request.resource.data.nafesClass == resource.data.nafesClass)
            || ((resource == null || !('nafesClass' in resource.data))
                && exists(/databases/$(database)/documents/durus_live/$(request.resource.data.lesson))
                && live(request.resource.data.lesson).cls == request.resource.data.cls
                && request.time < live(request.resource.data.lesson).until));
    }

    // كشف الطلاب: الطالب يتحقق من رمزه فقط، ولا يستطيع سرد الكشف
    match /durus_roster/{code} {
      allow get: if true;
      allow list, write: if request.auth != null;
    }

    // جلسة الحصة: يقرؤها الطلاب، ويديرها المعلم
    match /durus_live/{lesson} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // لوحة الشرف: يقرؤها الجميع، ولا ينشرها إلا معلم مسجّل
    match /durus_honor/{lesson} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // استبانة المعلم
    match /durus_teacher/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
